@model List<PrestamoDispositivos.DTO.deviceDTO>
@{
    ViewData["Title"] = "Dispositivos";
    bool canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Lender");
    bool isStudent = User.IsInRole("Student");
    Layout = "~/Views/Shared/_LayoutITM.cshtml";
}

<style>
    /* ── Fix layout ITM: quitar el centrado vertical ── */
    .itm-page {
        display: block !important;
        align-items: unset !important;
        padding: 0 !important;
    }

    /* ── Variables ── */
    :root {
        --gold: #c8a84b;
        --navy: #0a2240;
        --blue: #1a4080;
        --green: #2e7d32;
        --orange: #e65100;
        --red: #c0392b;
        --bg: #f0f4f8;
        --card: #ffffff;
        --border: #dde4ec;
        --text: #1e2d3d;
        --muted: #6b7f95;
        --r: 8px;
    }

    /* ── BARRA SUPERIOR DE LA VISTA ── */
    .dv-topbar {
        background: var(--navy);
        border-bottom: 3px solid var(--gold);
        padding: 1.1rem 0;
    }

    .dv-topbar__title {
        font-family: 'Barlow Condensed', 'Segoe UI', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: .03em;
    }

        .dv-topbar__title span {
            color: var(--gold);
        }

    .dv-search {
        position: relative;
        width: 280px;
    }

        .dv-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #8da9c4;
            font-size: .8rem;
            pointer-events: none;
        }

        .dv-search input {
            width: 100%;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 20px;
            color: #fff;
            padding: .42rem 1rem .42rem 2.2rem;
            font-size: .85rem;
            outline: none;
            transition: border-color .2s;
        }

            .dv-search input::placeholder {
                color: #8da9c4;
            }

            .dv-search input:focus {
                border-color: var(--gold);
            }

    .dv-btn-new {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: var(--gold);
        color: var(--navy);
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: .88rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: .42rem 1.1rem;
        border-radius: 20px;
        text-decoration: none;
        border: none;
        white-space: nowrap;
        transition: background .15s, transform .1s;
    }

        .dv-btn-new:hover {
            background: #b8943b;
            color: var(--navy);
            transform: translateY(-1px);
        }

    /* ── GRID AREA ── */
    .dv-grid-area {
        background: var(--bg);
        padding: 2rem 0 3rem;
        min-height: 60vh;
    }

    /* ── CARD ── */
    .dv-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--r);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: 0 1px 6px rgba(10,34,64,.07);
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

        .dv-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(10,34,64,.12);
            border-color: var(--gold);
        }

    /* ── IMAGEN: tamaño fijo controlado ── */
    .dv-card__thumb {
        width: 100%;
        height: 180px; /* altura fija — no crece más */
        background: #eef1f5;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

        .dv-card__thumb img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* muestra la imagen entera sin recortar */
            padding: .75rem;
            transition: transform .25s;
        }

    .dv-card:hover .dv-card__thumb img {
        transform: scale(1.05);
    }

    .dv-card__thumb-icon {
        font-size: 3.2rem;
        color: #b8c8d8;
    }

    /* ── BODY ── */
    .dv-card__body {
        padding: .8rem 1rem .6rem;
        flex: 1;
    }

    .dv-card__serial {
        font-size: .65rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--blue);
        display: block;
        margin-bottom: .18rem;
    }

    .dv-card__brand {
        font-size: .97rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: .2rem;
    }

    .dv-card__specs {
        font-size: .76rem;
        color: var(--muted);
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ── FOOTER ── */
    .dv-card__foot {
        padding: .65rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .4rem;
        border-top: 1px solid var(--border);
        background: #f8fafc;
        flex-shrink: 0;
    }

    /* ── BADGES ── */
    .dv-badge {
        font-size: .62rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: .25em .7em;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .dv-badge-disponible {
        background: #e8f5e9;
        color: var(--green);
        border: 1px solid #a5d6a7;
    }

    .dv-badge-prestado {
        background: #fff3e0;
        color: var(--orange);
        border: 1px solid #ffcc80;
    }

    .dv-badge-mantenimiento {
        background: #fdecea;
        color: var(--red);
        border: 1px solid #ef9a9a;
    }

    .dv-badge-default {
        background: #f0f4f8;
        color: var(--muted);
        border: 1px solid var(--border);
    }

    /* ── BOTONES DE ACCIÓN ── */
    .dv-acts {
        display: flex;
        gap: .35rem;
        align-items: center;
        flex-shrink: 0;
    }

    .dv-act {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .25rem;
        border-radius: 6px;
        padding: .32rem .6rem;
        font-size: .75rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: 1.5px solid transparent;
        transition: background .14s, color .14s;
        line-height: 1;
        white-space: nowrap;
    }

    .dv-act-edit {
        background: #e3f2fd;
        color: #1565c0;
        border-color: #90caf9;
    }

        .dv-act-edit:hover {
            background: #1565c0;
            color: #fff;
            border-color: #1565c0;
        }

    .dv-act-del {
        background: #fdecea;
        color: var(--red);
        border-color: #ef9a9a;
    }

        .dv-act-del:hover {
            background: var(--red);
            color: #fff;
            border-color: var(--red);
        }

    .dv-act-req {
        background: var(--blue);
        color: #fff;
        border-color: var(--blue);
    }

        .dv-act-req:hover {
            background: var(--navy);
            color: #fff;
            border-color: var(--navy);
        }

    .dv-act-off {
        background: #f0f4f8;
        color: #b0bec8;
        border-color: var(--border);
        cursor: not-allowed;
        opacity: .7;
        pointer-events: none;
    }

    /* ── EMPTY / SIN RESULTADOS ── */
    .dv-empty {
        text-align: center;
        padding: 5rem 1rem;
        color: var(--muted);
    }

        .dv-empty i {
            font-size: 3.5rem;
            opacity: .2;
            display: block;
            margin-bottom: .8rem;
        }

    #noResults {
        display: none;
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--muted);
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 768px) {
        .dv-topbar .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
            gap: .6rem;
        }

        .dv-search {
            width: 100%;
        }
    }
</style>

<!-- BARRA SUPERIOR -->
<div class="dv-topbar">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <h1 class="dv-topbar__title">
                <i class="bi bi-laptop me-2"></i>Dispositivos <span>ITM</span>
            </h1>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="dv-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" placeholder="Serial o marca…" autocomplete="off" />
                </div>
                @if (canManage)
                {
                    <a asp-controller="Device" asp-action="Create" class="dv-btn-new">
                        <i class="bi bi-plus-lg"></i> Nuevo dispositivo
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- GRID -->
<div class="dv-grid-area">
    <div class="container">

        @if (!Model.Any())
        {
            <div class="dv-empty">
                <i class="bi bi-laptop"></i>
                <p>No hay dispositivos registrados todavía.</p>
                @if (canManage)
                {
                    <a asp-controller="Device" asp-action="Create" class="dv-btn-new mt-3 d-inline-flex">
                        <i class="bi bi-plus-lg"></i> Agregar el primero
                    </a>
                }
            </div>
        }
        else
        {
            <div class="row g-4" id="deviceGrid">
                @foreach (var device in Model)
                {
                    string sl = device.EstadoEquipo?.ToLower() ?? "";
                    string bc = sl switch
                    {
                        "disponible" => "dv-badge-disponible",
                        "prestado" => "dv-badge-prestado",
                        "mantenimiento" => "dv-badge-mantenimiento",
                        _ => "dv-badge-default"
                    };

                    <div class="col-lg-4 col-md-6 device-item"
                         data-search="@((device.Serial + " " + device.Marca + " " + device.EstadoEquipo).ToLower())">
                        <div class="dv-card">

                            <!-- Imagen -->
                            <div class="dv-card__thumb">
                                @if (!string.IsNullOrWhiteSpace(device.URLImagen))
                                {
                                    <img src="@device.URLImagen" alt="@device.Marca" loading="lazy" />
                                }
                                else
                                {
                                    <i class="bi bi-laptop dv-card__thumb-icon"></i>
                                }
                            </div>

                            <!-- Info -->
                            <div class="dv-card__body">
                                <span class="dv-card__serial">Serial: @device.Serial</span>
                                <div class="dv-card__brand">@device.Marca</div>
                                <div class="dv-card__specs">@device.Especificaciones</div>
                            </div>

                            <!-- Footer -->
                            <div class="dv-card__foot">
                                <span class="dv-badge @bc">@device.EstadoEquipo</span>

                                <div class="dv-acts">
                                    @if (canManage)
                                    {
                                        <a asp-controller="Device" asp-action="Edit"
                                           asp-route-id="@device.IdDisp"
                                           class="dv-act dv-act-edit" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <button type="button"
                                                class="dv-act dv-act-del js-del"
                                                data-id="@device.IdDisp"
                                                data-name="@device.Marca (@device.Serial)"
                                                title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                    @if (isStudent && sl == "disponible")
                                    {
                                        <a asp-controller="Loan" asp-action="Create"
                                           asp-route-id="@device.IdDisp"
                                           class="dv-act dv-act-req">
                                            <i class="bi bi-calendar-check-fill"></i> Solicitar
                                        </a>
                                    }
                                    else if (isStudent)
                                    {
                                        <span class="dv-act dv-act-off">No disponible</span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

            <div id="noResults">
                <i class="bi bi-search" style="font-size:1.8rem;opacity:.2;"></i>
                <p class="mt-2 small">Sin resultados.</p>
            </div>
        }

    </div>
</div>

<!-- MODAL ELIMINAR -->
<div class="modal fade" id="modalDel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content" style="border-radius:8px;">
            <div class="modal-header" style="border-bottom:1px solid var(--border);">
                <h5 class="modal-title fw-bold" style="color:var(--red); font-size:.95rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close js-del-close"></button>
            </div>
            <div class="modal-body py-3" style="font-size:.88rem; color:var(--text);">
                ¿Eliminar <strong id="delName"></strong>?
                <br><span class="text-muted" style="font-size:.8rem;">Esta acción no se puede deshacer.</span>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--border); gap:.5rem;">
                <button type="button" class="btn btn-sm btn-outline-secondary js-del-close">Cancelar</button>
                <form id="delForm" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="delId" />
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash-fill me-1"></i>Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Búsqueda
        document.getElementById('searchInput')?.addEventListener('input', function () {
            const q = this.value.toLowerCase().trim();
            let n = 0;
            document.querySelectorAll('.device-item').forEach(el => {
                const show = el.dataset.search.includes(q);
                el.style.display = show ? '' : 'none';
                if (show) n++;
            });
            const nr = document.getElementById('noResults');
            if (nr) nr.style.display = (!n && q) ? 'block' : 'none';
        });

        // Modal eliminar — instancia única, solo se abre por JS
        const _modalEl = document.getElementById('modalDel');
        let _modalBS = null;

        function openDelModal(id, name) {
            document.getElementById('delId').value = id;
            document.getElementById('delName').textContent = name;
            document.getElementById('delForm').action = '/Device/Delete';
            if (!_modalBS) _modalBS = new bootstrap.Modal(_modalEl, { backdrop: 'static', keyboard: false });
            _modalBS.show();
        }

        function closeDelModal() { _modalBS?.hide(); }

        document.querySelectorAll('.js-del').forEach(btn => {
            btn.addEventListener('click', () => openDelModal(btn.dataset.id, btn.dataset.name));
        });

        document.querySelectorAll('.js-del-close').forEach(btn => {
            btn.addEventListener('click', closeDelModal);
        });
    </script>
}
