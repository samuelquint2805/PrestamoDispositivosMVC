@model List<PrestamoDispositivos.DTO.deviceDTO>
@{
    ViewData["Title"] = "Dispositivos";
    bool canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Lender");
    // ✅ Detectamos si es estudiante
    bool isStudent = User.IsInRole("Student");
}

@* ... (Mantenemos tus estilos CSS igual) ... *@

<!-- GRID DE DISPOSITIVOS -->
<div class="container mb-5">
    @if (!Model.Any())
    {
        @* ... (Mantenemos el estado vacío igual) ... *@
    }
    else
    {
        <div class="row gy-4" id="deviceGrid">
            @foreach (var device in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 device-item"
                     data-search="@((device.Serial + " " + device.Marca + " " + device.EstadoEquipo).ToLower())">
                    <div class="device-card">

                        <!-- Imagen -->
                        <div class="device-card__img-wrap">
                            @if (!string.IsNullOrWhiteSpace(device.URLImagen))
                            {
                                <img src="@device.URLImagen" alt="@device.Marca" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi bi-laptop device-card__img-placeholder"></i>
                            }
                        </div>

                        <!-- Info -->
                        <div class="device-card__body">
                            <span class="device-card__serial">Serial: @device.Serial</span>
                            <div class="device-card__brand">@device.Marca</div>
                            <div class="device-card__specs">@device.Especificaciones</div>
                        </div>

                        <!-- Footer -->
                        <div class="device-card__footer">
                            @{
                                string statusLower = device.EstadoEquipo?.ToLower() ?? "";
                                string badgeCls = statusLower switch
                                {
                                    "disponible" => "status-disponible",
                                    "prestado" => "status-prestado",
                                    "mantenimiento" => "status-mantenimiento",
                                    _ => "status-default"
                                };
                            }
                            <span class="status-badge @badgeCls">@device.EstadoEquipo</span>

                            <div class="d-flex gap-2">
                                @* 🛠 ACCIONES PARA ADMIN/PRESTAMISTA *@
                                @if (canManage)
                                {
                                    <a asp-controller="Device" asp-action="Edit"
                                           asp-route-id="@device.IdDisp"
                                           class="btn-itm-outline" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button"
                                            class="btn-itm-danger btn-delete"
                                            data-id="@device.IdDisp"
                                            data-name="@device.Marca (@device.Serial)"
                                            title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }

                                @* 🚀 ACCIÓN PARA ESTUDIANTE: Solicitar si está disponible *@
                                @if (isStudent && statusLower == "disponible")
                                {
                                    @* IMPORTANTE: asp-route-id es lo que pone el ID en la URL *@
                                    <a asp-controller="Loan"
                                       asp-action="Create"
                                       asp-route-id="@device.IdDisp"
                                       class="btn-itm-primary">
                                        <i class="bi bi-calendar-check me-1"></i> Solicitar
                                    </a>
                                }
                                else if (isStudent && statusLower != "disponible")
                                {
                                    <button class="btn-itm-outline" disabled style="opacity: 0.5; cursor: not-allowed;">
                                        No disponible
                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@* ... (Mantenemos tus Scripts y Modales de borrado igual) ... *@