@model PrestamoDispositivos.DTO.deviceDTO
@{
    ViewData["Title"] = "Editar Dispositivo";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #0a2240 0%, #1a4080 100%);
        color: #fff;
        padding: 1.8rem 0 1.4rem;
        margin-bottom: 2rem;
        border-bottom: 3px solid #c8a84b;
    }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: .2rem; }
    .page-header p  { color: #a8bcd0; font-size: .9rem; margin: 0; }

    .form-card {
        background: #fff;
        border: 1px solid #c8d4e0;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(10,34,64,.08);
        padding: 2rem 2.2rem;
        max-width: 680px;
    }

    .f-label {
        display: block;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #6b7f95;
        margin-bottom: .3rem;
    }
    .f-input, .f-select, .f-textarea {
        width: 100%;
        border: 1px solid #c8d4e0;
        border-radius: 4px;
        padding: .6rem .9rem;
        font-size: .95rem;
        color: #1e2d3d;
        background: #fafbfc;
        outline: none;
        transition: border-color .18s, box-shadow .18s;
    }
    .f-textarea { resize: vertical; min-height: 90px; }
    .f-input:focus, .f-select:focus, .f-textarea:focus {
        border-color: #1a4080;
        box-shadow: 0 0 0 3px rgba(26,64,128,.1);
        background: #fff;
    }
    .f-input.input-validation-error,
    .f-select.input-validation-error,
    .f-textarea.input-validation-error { border-color: #c0392b; }

    .field-validation-error { color: #c0392b; font-size: .78rem; margin-top: .2rem; display: block; }
    .f-group { margin-bottom: 1.15rem; }

    .img-preview-wrap {
        width: 100%; height: 180px;
        border: 2px dashed #c8d4e0;
        border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden; background: #f0f4f8;
        margin-top: .4rem; transition: border-color .2s;
    }
    .img-preview-wrap.has-img { border-style: solid; border-color: #1a4080; }
    .img-preview-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .img-preview-wrap i   { font-size: 2.5rem; color: #c8d4e0; }

    /* Id badge */
    .id-badge {
        display: inline-flex; align-items: center; gap: .4rem;
        background: #e8eef5; color: #4a5568; font-size: .75rem;
        font-weight: 600; padding: .2rem .65rem; border-radius: 3px;
        margin-bottom: 1.2rem; font-family: monospace;
    }

    .btn-submit {
        background: #1a4080; color: #fff; border: none;
        padding: .65rem 2rem; border-radius: 4px;
        font-size: .98rem; font-weight: 700;
        letter-spacing: .04em; cursor: pointer;
        transition: background .18s;
        display: inline-flex; align-items: center; gap: .4rem;
    }
    .btn-submit:hover { background: #0a2240; }

    .btn-cancel {
        background: transparent; color: #1a4080;
        border: 1.5px solid #1a4080;
        padding: .63rem 1.4rem; border-radius: 4px;
        font-size: .95rem; font-weight: 600;
        text-decoration: none;
        display: inline-flex; align-items: center; gap: .4rem;
        transition: all .18s;
    }
    .btn-cancel:hover { background: #e8eef5; color: #0a2240; }

    .validation-summary-errors {
        background: #fdf0ef; border: 1px solid #e8b4b0;
        border-radius: 4px; padding: .7rem .9rem;
        margin-bottom: 1rem; font-size: .85rem; color: #9b2a1f;
    }
    .validation-summary-errors ul { padding-left: 1.1rem; }
</style>

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb" style="margin-bottom:.4rem;">
            <a asp-controller="Device" asp-action="Index"
               style="color:#a8bcd0; font-size:.82rem; text-decoration:none;">
                <i class="bi bi-laptop"></i> Dispositivos
            </a>
            <span style="color:#4a6080; margin:0 .4rem;">/</span>
            <span style="color:#fff; font-size:.82rem;">Editar</span>
        </nav>
        <h1><i class="bi bi-pencil-square me-2"></i>Editar Dispositivo</h1>
        <p>Modifica la información del equipo en el inventario</p>
    </div>
</div>

<div class="container mb-5">
    <div class="form-card">

        <!-- Badge con el ID del dispositivo -->
        <div class="id-badge">
            <i class="bi bi-fingerprint"></i> ID: @Model.IdDisp
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-action="Edit" asp-controller="Device" asp-route-id="@Model.IdDisp" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdDisp)

            <div class="row">
                <div class="col-md-6">
                    <div class="f-group">
                        <label class="f-label" asp-for="Serial">Serial</label>
                        @Html.TextBoxFor(m => m.Serial, new { @class = "f-input", placeholder = "Ej: SN-2024-001" })
                        <span asp-validation-for="Serial" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="f-group">
                        <label class="f-label" asp-for="Marca">Marca</label>
                        @Html.TextBoxFor(m => m.Marca, new { @class = "f-input", placeholder = "Ej: Dell, HP, Lenovo" })
                        <span asp-validation-for="Marca" class="field-validation-error"></span>
                    </div>
                </div>
            </div>

            <div class="f-group">
                <label class="f-label" asp-for="Especificaciones">Especificaciones</label>
                @Html.TextAreaFor(m => m.Especificaciones, new { @class = "f-textarea", placeholder = "RAM, procesador, almacenamiento, pantalla…" })
                <span asp-validation-for="Especificaciones" class="field-validation-error"></span>
            </div>

            <div class="f-group">
                <label class="f-label" asp-for="EstadoEquipo">Estado del Dispositivo</label>
                @Html.DropDownListFor(m => m.EstadoEquipo,
                    new SelectList(
                        new[] { "Disponible", "Prestado", "Mantenimiento", "Dañado", "Baja" },
                        Model.EstadoEquipo),
                    "— Selecciona un estado —",
                    new { @class = "f-select" })
                <span asp-validation-for="EstadoEquipo" class="field-validation-error"></span>
            </div>

            <div class="f-group">
                <label class="f-label" asp-for="URLImagen">URL de Imagen</label>
                @Html.TextBoxFor(m => m.URLImagen, new {
                    @class      = "f-input",
                    placeholder = "https://…",
                    id          = "urlImagenInput"
                })
                <span asp-validation-for="URLImagen" class="field-validation-error"></span>

                <!-- Preview de imagen -->
                <div class="img-preview-wrap mt-2" id="imgPreview">
                    <i class="bi bi-image"></i>
                </div>
            </div>

            <div class="d-flex gap-3 mt-3 flex-wrap">
                <button type="submit" class="btn-submit">
                    <i class="bi bi-check-circle"></i> Guardar Cambios
                </button>
                <a asp-controller="Device" asp-action="Index" class="btn-cancel">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var urlInput = document.getElementById('urlImagenInput');
        var preview  = document.getElementById('imgPreview');

        function updatePreview(url) {
            if (!url || url.trim() === '') {
                preview.innerHTML = '<i class="bi bi-image"></i>';
                preview.classList.remove('has-img');
                return;
            }
            var img = document.createElement('img');
            img.src = url.trim();
            img.alt = 'Preview';
            img.onerror = function () {
                preview.innerHTML = '<i class="bi bi-image-fill" style="color:#c0392b;font-size:2rem;" title="URL no válida"></i>';
                preview.classList.remove('has-img');
            };
            img.onload = function () {
                preview.innerHTML = '';
                preview.appendChild(img);
                preview.classList.add('has-img');
            };
        }

        urlInput.addEventListener('input', function () { updatePreview(this.value); });
        // Cargar preview con la imagen actual al abrir el formulario
        if (urlInput.value) updatePreview(urlInput.value);
    </script>
}
