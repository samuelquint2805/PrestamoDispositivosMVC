@model PrestamoDispositivos.Models.ViewModels.RegisterViewModel
@{
    Layout = "~/Views/Shared/_LayoutITM.cshtml";
    ViewData["Title"] = "Crear Cuenta";
}

<div class="itm-card">

    <div class="itm-steps">
        <div class="itm-step active">1 &middot; Datos de Acceso</div>
        <div class="itm-step">2 &middot; Perfil</div>
    </div>

    <h1 class="itm-card__title">Crear Cuenta</h1>

    <div id="roleHint" style="margin-bottom:1rem;min-height:24px;font-size:.83rem;color:#555;">
        Ingresa tu correo para detectar tu rol automáticamente.
    </div>

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <form asp-action="Register" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()

        <div class="itm-field">
            <label class="itm-label" asp-for="Email">Correo Institucional</label>
            @Html.TextBoxFor(m => m.Email, new {
                @class        = "itm-input",
                type          = "email",
                placeholder   = "Correo Institucional",
                id            = "emailField",
                autocomplete  = "email"
            })
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div id="extraFields" style="display:none;">

            <div class="itm-field">
                <label class="itm-label" asp-for="UserName">Nombre de Usuario</label>
                @Html.TextBoxFor(m => m.UserName, new {
                    @class       = "itm-input",
                    type         = "text",
                    placeholder  = "Nombre de usuario",
                    autocomplete = "username"
                })
                <span asp-validation-for="UserName" class="field-validation-error"></span>
            </div>

            <div class="itm-field">
                <label class="itm-label" asp-for="Password">Contraseña</label>
                @Html.PasswordFor(m => m.Password, new {
                    @class       = "itm-input",
                    placeholder  = "Mínimo 6 caracteres",
                    autocomplete = "new-password"
                })
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="itm-field">
                <label class="itm-label" asp-for="ConfirmPassword">Confirmar Contraseña</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new {
                    @class       = "itm-input",
                    placeholder  = "Repite tu contraseña",
                    autocomplete = "new-password"
                })
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

        </div>

        <button type="submit" class="itm-btn" id="submitBtn">Iniciar Registro</button>
    </form>

    <div class="itm-links" style="justify-content:center;">
        <a asp-action="Login" asp-controller="Account">¿Ya tienes cuenta? Inicia Sesión</a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var emailField  = document.getElementById('emailField');
        var extraFields = document.getElementById('extraFields');
        var roleHint    = document.getElementById('roleHint');
        var submitBtn   = document.getElementById('submitBtn');

        // En Razor, @@ se renderiza comoen el HTML final del navegador
        var SUPERADMIN_DOMAINS = ['@@superadmin.com'];
        var SUPERADMIN_EMAILS  = ['superadmin@@ejemplo.com', 'root@@ejemplo.com'];
        var LENDER_DOMAINS     = ['@@prestamista.com', '@@lender.com'];

        var ROLE_META = {
            superadmin: { label: 'SuperAdmin',  cls: 'role-tag--admin'   },
            lender:     { label: 'Prestamista', cls: 'role-tag--lender'  },
            student:    { label: 'Estudiante',  cls: 'role-tag--student' }
        };

        function detectRole(email) {
            var e = email.toLowerCase().trim();
            if (SUPERADMIN_EMAILS.some(function(x) { return x === e; }))        return 'superadmin';
            if (SUPERADMIN_DOMAINS.some(function(d) { return e.endsWith(d); })) return 'superadmin';
            if (LENDER_DOMAINS.some(function(d) { return e.endsWith(d); }))     return 'lender';
            return 'student';
        }

        function onEmailChange() {
            var val = emailField.value.trim();

            if (val.length < 5 || val.indexOf('@@') === -1) {
                roleHint.innerHTML        = 'Ingresa tu correo para detectar tu rol automáticamente.';
                extraFields.style.display = 'none';
                submitBtn.textContent     = 'Iniciar Registro';
                return;
            }

            var key  = detectRole(val);
            var meta = ROLE_META[key];
            roleHint.innerHTML        = 'Rol detectado: <span class="role-tag ' + meta.cls + '">' + meta.label + '</span>';
            extraFields.style.display = 'block';
            submitBtn.textContent     = 'Continuar';
        }

        emailField.addEventListener('input', onEmailChange);

        // Si el modelo regresa con errores de validación, expandir campos si ya hay email
        if (emailField.value.trim().length > 4) {
            onEmailChange();
        }
    </script>
}
