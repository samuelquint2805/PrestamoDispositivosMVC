@model PrestamoDispositivos.Models.ViewModels.CompleteStudentProfileViewModel
@{
    Layout = "~/Views/Shared/_LayoutITM.cshtml";
    ViewData["Title"] = "Perfil de Estudiante";
}

<div class="itm-card itm-card--wide">

    <div class="itm-steps">
        <div class="itm-step done">1 · Datos de Acceso ✓</div>
        <div class="itm-step active">2 · Perfil Estudiante</div>
    </div>

    <h1 class="itm-card__title">
        Completa tu Perfil
        <span class="role-tag role-tag--student">Estudiante</span>
    </h1>

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <form asp-action="CompleteStudentProfile" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()

        <div class="itm-field">
            <label class="itm-label" asp-for="Nombre">Nombre Completo</label>
            <input class="itm-input" asp-for="Nombre"
                   type="text"
                   placeholder="Nombre" />
            <span asp-validation-for="Nombre" class="field-validation-error"></span>
        </div>

        <div class="itm-grid-2">
            <div class="itm-field">
                <label class="itm-label" asp-for="Carnet">Carnet</label>
                <input class="itm-input" asp-for="Carnet"
                       type="number"
                       placeholder="Número de carnet" />
                <span asp-validation-for="Carnet" class="field-validation-error"></span>
            </div>

            <div class="itm-field">
                <label class="itm-label" asp-for="DocumentoID">Documento de Identidad</label>
                <input class="itm-input" asp-for="DocumentoID"
                       type="number"
                       placeholder="Cédula / TI" />
                <span asp-validation-for="DocumentoID" class="field-validation-error"></span>
            </div>
        </div>

        <div class="itm-field">
            <label class="itm-label" asp-for="NumeroCelular">Celular</label>
            <input class="itm-input" asp-for="NumeroCelular"
                   type="number"
                   placeholder="Celular:" />
            <span asp-validation-for="NumeroCelular" class="field-validation-error"></span>
        </div>

        <button type="submit" class="itm-btn">Crear Cuenta</button>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
