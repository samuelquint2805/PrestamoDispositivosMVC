@model PrestamoDispositivos.Models.ViewModels.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutITM.cshtml";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="itm-card">

    <h1 class="itm-card__title">Página Para Préstamo de Equipos Informáticos</h1>

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <form asp-action="Login" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="itm-field">
            <label class="itm-label" asp-for="Email">Correo Institucional</label>
            <input class="itm-input" asp-for="Email"
                   type="email"
                   placeholder="Correo Institucional"
                   autocomplete="username" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="itm-field">
            <label class="itm-label" asp-for="Password">Contraseña</label>
            <input class="itm-input" asp-for="Password"
                   type="password"
                   placeholder="Contraseña"
                   autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <button type="submit" class="itm-btn">Iniciar Sesión</button>
    </form>

    <div class="itm-links">
        <a asp-action="Register" asp-controller="Account">Crear Cuenta</a>
        <a asp-action="ForgotPassword" asp-controller="Account">Olvidé Contraseña</a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
