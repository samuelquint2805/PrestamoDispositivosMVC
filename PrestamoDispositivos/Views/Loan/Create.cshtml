@model PrestamoDispositivos.DTO.LoanDTO
@{
    ViewData["Title"] = "Nuevo Préstamo";
    var students = ViewBag.Students as List<PrestamoDispositivos.DTO.StudentDTO> ?? new List<PrestamoDispositivos.DTO.StudentDTO>();
    var devices = ViewBag.Devices as List<PrestamoDispositivos.DTO.deviceDTO> ?? new List<PrestamoDispositivos.DTO.deviceDTO>();
    var currentStudentId = ViewBag.CurrentStudentId as Guid?;
    var isStudentCreating = ViewBag.IsStudentCreating ?? false;
}

<div class="itm-card" style="max-width: 520px; margin: 60px auto; padding: 36px; border-radius: 12px; background: white; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">

    @* Encabezado *@
    <div style="margin-bottom: 28px; border-bottom: 2px solid #f0a500; padding-bottom: 16px;">
        <h1 style="font-size: 22px; font-weight: 600; color: #1a3a6b; margin: 0;">Solicitar Préstamo</h1>
        <p style="font-size: 13px; color: #6b7280; margin: 6px 0 0;">Instituto Tecnológico Metropolitano</p>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @* Campo oculto con el ID del dispositivo *@
        <input type="hidden" asp-for="IdDispo" />

        @* Dispositivo (solo visual) *@
        <div style="margin-bottom: 20px;">
            <label style="font-size: 13px; color: #6b7280; display: block; margin-bottom: 6px;">Dispositivo</label>
            <input type="text" value="@ViewBag.MarcaDispositivo" class="form-control" readonly
                   style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px 14px; font-size: 14px; color: #374151;" />
        </div>

        @* Fecha del evento *@
        <div style="margin-bottom: 28px;">
            <input type="date" asp-for="FechaEvento"
                   min="@DateTime.Now.ToString("yyyy-MM-dd")"
                   style="width: 100%; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px 14px; font-size: 14px; color: #374151;" />
            <span asp-validation-for="FechaEvento" style="color: #dc2626; font-size: 12px;"></span>
        </div>

        @* Botón *@
        <button type="submit"
                style="width: 100%; background: #1a3a6b; color: white; border: none; border-radius: 8px; padding: 12px; font-size: 15px; font-weight: 500; cursor: pointer;">
            Confirmar préstamo
        </button>

        <a asp-controller="Device" asp-action="Index"
           style="display: block; text-align: center; margin-top: 14px; font-size: 13px; color: #6b7280; text-decoration: none;">
            Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}