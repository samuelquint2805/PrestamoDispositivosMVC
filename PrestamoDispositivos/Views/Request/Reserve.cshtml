@{
    ViewData["Title"] = "Confirmar Solicitud";
    var device = ViewBag.Device as PrestamoDispositivos.DTO.deviceDTO;
    Layout = "~/Views/Shared/_LayoutITM.cshtml";
}

<style>
    .itm-page {
        display: block !important;
        align-items: unset !important;
        padding: 0 !important;
    }

    :root {
        --gold: #c8a84b;
        --navy: #0a2240;
        --blue: #1a4080;
        --green: #2e7d32;
        --border: #dde4ec;
        --muted: #6b7f95;
    }

    .rv-header {
        background: var(--navy);
        border-bottom: 3px solid var(--gold);
        padding: 1.1rem 0;
    }

    .rv-breadcrumb {
        font-size: .8rem;
        margin-bottom: .35rem;
    }

        .rv-breadcrumb a {
            color: #8da9c4;
            text-decoration: none;
        }

            .rv-breadcrumb a:hover {
                color: var(--gold);
            }

        .rv-breadcrumb span {
            color: #4a6080;
            margin: 0 .35rem;
        }

    .rv-header h1 {
        font-family: 'Barlow Condensed','Segoe UI',sans-serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: .02em;
    }

    .rv-header p {
        color: #8da9c4;
        font-size: .82rem;
        margin: .25rem 0 0;
    }

    .rv-area {
        background: #f0f4f8;
        padding: 2.5rem 0 3rem;
        min-height: 60vh;
    }

    .rv-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 16px rgba(10,34,64,.09);
        max-width: 500px;
        margin: 0 auto;
        overflow: hidden;
    }

    .rv-card__thumb {
        height: 200px;
        background: #eef1f5;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
    }

        .rv-card__thumb img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 1rem;
        }

        .rv-card__thumb i {
            font-size: 4rem;
            color: #c8d4e0;
        }

    .rv-card__body {
        padding: 1.5rem 1.8rem;
    }

    .rv-card__name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 1rem;
    }

    .rv-spec {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: .5rem 0;
        border-bottom: 1px solid #eef1f5;
        font-size: .87rem;
    }

        .rv-spec:last-of-type {
            border-bottom: none;
        }

    .rv-spec__label {
        color: var(--muted);
        font-size: .73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .rv-spec__value {
        color: #1e2d3d;
        font-weight: 600;
        text-align: right;
        max-width: 60%;
    }

    .rv-info {
        background: #e8f4fd;
        border: 1px solid #bee3f8;
        border-radius: 6px;
        padding: .85rem 1rem;
        margin: 1.2rem 0;
        font-size: .84rem;
        color: #1565c0;
        display: flex;
        gap: .6rem;
        align-items: flex-start;
    }

        .rv-info i {
            font-size: 1rem;
            flex-shrink: 0;
            margin-top: .1rem;
        }

    .rv-actions {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        margin-top: 1.2rem;
    }

    .rv-btn-confirm {
        flex: 1;
        background: var(--blue);
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: .65rem 1rem;
        font-size: .9rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        transition: background .18s;
    }

        .rv-btn-confirm:hover {
            background: var(--navy);
        }

    .rv-btn-back {
        flex: 1;
        background: transparent;
        color: var(--muted);
        border: 1.5px solid var(--border);
        border-radius: 7px;
        padding: .62rem 1rem;
        font-size: .88rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        transition: all .18s;
    }

        .rv-btn-back:hover {
            background: #e8eef5;
            color: #1e2d3d;
        }
</style>

<!-- HEADER -->
<div class="rv-header">
    <div class="container">
        <div class="rv-breadcrumb">
            <a asp-controller="Device" asp-action="Index"><i class="bi bi-laptop me-1"></i>Dispositivos</a>
            <span>/</span>
            <span style="color:#fff;">Confirmar Solicitud</span>
        </div>
        <h1><i class="bi bi-bookmark-check me-2"></i>Confirmar Solicitud</h1>
        <p>Revisa los detalles antes de enviar tu solicitud al prestamista</p>
    </div>
</div>

<!-- CONTENIDO -->
<div class="rv-area">
    <div class="container">
        <div class="rv-card">

            <div class="rv-card__thumb">
                @if (device != null && !string.IsNullOrWhiteSpace(device.URLImagen))
                {
                    <img src="@device.URLImagen" alt="@device.Marca" />
                }
                else
                {
                    <i class="bi bi-laptop"></i>
                }
            </div>

            <div class="rv-card__body">
                <div class="rv-card__name">@device?.Marca</div>

                <div class="rv-spec">
                    <span class="rv-spec__label">Serial</span>
                    <span class="rv-spec__value">@device?.Serial</span>
                </div>
                <div class="rv-spec">
                    <span class="rv-spec__label">Especificaciones</span>
                    <span class="rv-spec__value">@device?.Especificaciones</span>
                </div>
                <div class="rv-spec">
                    <span class="rv-spec__label">Estado</span>
                    <span class="rv-spec__value" style="color:var(--green);">@device?.EstadoEquipo</span>
                </div>

                <div class="rv-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        Al confirmar se enviará una <strong>solicitud de reserva</strong> al prestamista.
                        Te notificarán cuando sea aprobada o rechazada.
                    </div>
                </div>

                <form asp-action="Reserve" asp-controller="Request" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idDevice" value="@device?.IdDisp" />
                    <input type="hidden" name="confirm" value="yes" />
                    <div class="rv-actions">
                        <button type="submit" class="rv-btn-confirm">
                            <i class="bi bi-send-fill"></i> Enviar Solicitud
                        </button>
                        <a asp-controller="Device" asp-action="Index" class="rv-btn-back">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
