@model PrestamoDispositivos.DTO.RequestoDTO
@{
    ViewData["Title"] = "Revisar Solicitud";
    Layout = "~/Views/Shared/_LayoutITM.cshtml";
    var disponibles = ViewBag.DisponiblesDevice as List<PrestamoDispositivos.DTO.deviceDTO>
                      ?? new List<PrestamoDispositivos.DTO.deviceDTO>();
}

<style>
    .itm-page {
        display: block !important;
        align-items: unset !important;
        padding: 0 !important;
    }

    :root {
        --gold: #c8a84b;
        --navy: #0a2240;
        --blue: #1a4080;
        --green: #2e7d32;
        --red: #c0392b;
        --border: #dde4ec;
        --muted: #6b7f95;
        --bg: #f0f4f8;
        --text: #1e2d3d;
    }

    .rv-header {
        background: var(--navy);
        border-bottom: 3px solid var(--gold);
        padding: 1.1rem 0;
    }

    .rv-breadcrumb {
        font-size: .8rem;
        margin-bottom: .35rem;
    }

        .rv-breadcrumb a {
            color: #8da9c4;
            text-decoration: none;
        }

            .rv-breadcrumb a:hover {
                color: var(--gold);
            }

        .rv-breadcrumb span {
            color: #4a6080;
            margin: 0 .35rem;
        }

    .rv-header h1 {
        font-family: 'Barlow Condensed','Segoe UI',sans-serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .rv-header p {
        color: #8da9c4;
        font-size: .82rem;
        margin: .2rem 0 0;
    }

    .rv-area {
        background: var(--bg);
        padding: 2rem 0 3rem;
        min-height: 60vh;
    }

    .rv-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 14px rgba(10,34,64,.09);
        max-width: 580px;
        margin: 0 auto;
    }

    .rv-card__body {
        padding: 1.5rem 1.8rem;
    }

    .rv-section-title {
        font-family: 'Barlow Condensed','Segoe UI',sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--navy);
        border-bottom: 2px solid var(--gold);
        padding-bottom: .45rem;
        margin: 0 0 1rem;
    }

    .rv-detail {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: .52rem 0;
        border-bottom: 1px solid #eef1f5;
        font-size: .87rem;
    }

        .rv-detail:last-of-type {
            border-bottom: none;
            margin-bottom: .5rem;
        }

    .rv-detail__label {
        color: var(--muted);
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        flex-shrink: 0;
    }

    .rv-detail__value {
        font-weight: 600;
        color: var(--text);
        text-align: right;
        max-width: 65%;
        word-break: break-word;
    }

    .rv-badge-pendiente {
        display: inline-block;
        background: #fff3e0;
        color: #e65100;
        border: 1px solid #ffcc80;
        padding: .22em .7em;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .rv-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 1.2rem 0;
    }

    .f-label {
        display: block;
        font-size: .73rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: .3rem;
    }

    .f-select {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: .58rem .9rem;
        font-size: .88rem;
        outline: none;
        color: var(--text);
        transition: border-color .18s;
        background: #fff;
    }

        .f-select:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(26,64,128,.1);
        }

    .f-textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: .6rem .9rem;
        font-size: .88rem;
        resize: vertical;
        min-height: 75px;
        outline: none;
        transition: border-color .18s;
        font-family: inherit;
        color: var(--text);
    }

        .f-textarea:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(26,64,128,.1);
        }

    /* Panel dispositivo — se muestra solo al elegir Aprobar */
    .rv-device-panel {
        display: none;
        background: #f0f8ff;
        border: 1px solid #bee3f8;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1rem;
    }

        .rv-device-panel.visible {
            display: block;
        }

    .rv-actions {
        display: flex;
        gap: .7rem;
        flex-wrap: wrap;
        margin-top: 1.2rem;
        align-items: center;
    }

    .rv-btn-approve {
        flex: 1;
        min-width: 120px;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: .62rem 1rem;
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        transition: background .18s;
    }

        .rv-btn-approve:hover {
            background: #1b5e20;
        }

    .rv-btn-reject {
        flex: 1;
        min-width: 120px;
        background: transparent;
        color: var(--red);
        border: 1.5px solid var(--red);
        border-radius: 7px;
        padding: .6rem 1rem;
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        transition: all .18s;
    }

        .rv-btn-reject:hover {
            background: #fdecea;
        }

    .rv-btn-back {
        background: transparent;
        color: var(--muted);
        border: 1.5px solid var(--border);
        border-radius: 7px;
        padding: .6rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: all .18s;
        white-space: nowrap;
    }

        .rv-btn-back:hover {
            background: #e8eef5;
            color: var(--text);
        }
</style>

<!-- HEADER -->
<div class="rv-header">
    <div class="container">
        <div class="rv-breadcrumb">
            <a asp-action="Index" asp-controller="Request"><i class="bi bi-send-check me-1"></i>Solicitudes</a>
            <span>/</span>
            <span style="color:#fff;">Revisar</span>
        </div>
        <h1><i class="bi bi-clipboard-check me-2"></i>Revisar Solicitud</h1>
        <p>Aprueba o rechaza la solicitud y asigna el dispositivo a entregar</p>
    </div>
</div>

<!-- CONTENIDO -->
<div class="rv-area">
    <div class="container">
        <div class="rv-card">
            <div class="rv-card__body">

                <!-- Detalle solicitud -->
                <p class="rv-section-title">Detalle de la Solicitud</p>

                <div class="rv-detail">
                    <span class="rv-detail__label">ID</span>
                    <span class="rv-detail__value" style="font-family:monospace;font-size:.76rem;">@Model.IdSolicitud</span>
                </div>
                <div class="rv-detail">
                    <span class="rv-detail__label">Estudiante</span>
                    <span class="rv-detail__value">@(Model.User?.usuario ?? "—")</span>
                </div>
                <div class="rv-detail">
                    <span class="rv-detail__label">Correo</span>
                    <span class="rv-detail__value">@(Model.User?.CorreoElectrónico ?? "—")</span>
                </div>
                <div class="rv-detail">
                    <span class="rv-detail__label">Fecha Solicitud</span>
                    <span class="rv-detail__value">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="rv-detail">
                    <span class="rv-detail__label">Estado</span>
                    <span class="rv-detail__value"><span class="rv-badge-pendiente">@Model.EstadoSolicitud</span></span>
                </div>

                <hr class="rv-divider" />

                <!-- Decisión -->
                <p class="rv-section-title">Decisión</p>

                <form asp-action="Review" asp-controller="Request" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdSolicitud" value="@Model.IdSolicitud" />

                    <!-- Observación -->
                    <div style="margin-bottom:1rem;">
                        <label class="f-label" for="Observacion">Observación (opcional)</label>
                        <textarea class="f-textarea" id="Observacion" name="Observacion"
                                  placeholder="Motivo de aprobación o rechazo…"></textarea>
                    </div>

                    <!-- Panel dispositivo: visible solo al elegir Aprobar -->
                    <div class="rv-device-panel" id="devicePanel">
                        <label class="f-label" for="IdDispo">
                            <i class="bi bi-laptop me-1" style="color:var(--blue);"></i>
                            Dispositivo a entregar <span style="color:var(--red);">*</span>
                        </label>
                        @if (disponibles.Any())
                        {
                            <select class="f-select" id="IdDispo" name="IdDispo">
                                <option value="">— Selecciona un dispositivo —</option>
                                @foreach (var d in disponibles)
                                {
                                    <option value="@d.IdDisp">@d.Marca — Serial: @d.Serial</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div style="background:#fff3e0;border:1px solid #ffcc80;border-radius:6px;padding:.7rem .9rem;font-size:.84rem;color:#e65100;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                No hay dispositivos disponibles en este momento. No puedes aprobar la solicitud.
                            </div>
                            <input type="hidden" name="IdDispo" value="" />
                        }
                    </div>

                    <!-- Botones -->
                    <div class="rv-actions">
                        <button type="submit" name="NuevoEstado" value="Aprobada"
                                class="rv-btn-approve" id="btnAprobar">
                            <i class="bi bi-check-circle-fill"></i> Aprobar
                        </button>
                        <button type="submit" name="NuevoEstado" value="Rechazada"
                                class="rv-btn-reject"
                                onclick="return confirm('¿Seguro que deseas rechazar esta solicitud?')">
                            <i class="bi bi-x-circle-fill"></i> Rechazar
                        </button>
                        <a asp-action="Index" asp-controller="Request" class="rv-btn-back">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const btnAprobar = document.getElementById('btnAprobar');
        const devicePanel = document.getElementById('devicePanel');
        const selectDispo = document.getElementById('IdDispo');

        // Mostrar panel de dispositivo al hacer hover/focus en Aprobar
        // y ocultarlo si se va hacia Rechazar
        btnAprobar?.addEventListener('mouseenter', () => devicePanel.classList.add('visible'));
        btnAprobar?.addEventListener('focus', () => devicePanel.classList.add('visible'));

        // Al enviar con Aprobar, validar que haya dispositivo seleccionado
        btnAprobar?.addEventListener('click', function (e) {
            devicePanel.classList.add('visible');
            if (selectDispo && !selectDispo.value) {
                e.preventDefault();
                selectDispo.style.borderColor = 'var(--red)';
                selectDispo.focus();
                selectDispo.setCustomValidity('Selecciona un dispositivo');
                selectDispo.reportValidity();
            }
        });

        selectDispo?.addEventListener('change', function () {
            this.style.borderColor = '';
            this.setCustomValidity('');
        });
    </script>
}
