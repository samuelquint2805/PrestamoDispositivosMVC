@model PrestamoDispositivos.DTO.RequestoDTO
@{
    ViewData["Title"] = "Revisar Solicitud";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #0a2240 0%, #1a4080 100%);
        color: #fff; padding: 1.8rem 0 1.4rem;
        margin-bottom: 2rem; border-bottom: 3px solid #c8a84b;
    }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: .2rem; }
    .page-header p  { color: #a8bcd0; font-size: .9rem; margin: 0; }

    .review-card {
        background: #fff; border: 1px solid #c8d4e0; border-radius: 8px;
        box-shadow: 0 2px 12px rgba(10,34,64,.08);
        padding: 2rem 2.2rem; max-width: 580px;
    }

    .detail-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: .6rem 0; border-bottom: 1px solid #e8eef5; font-size: .9rem;
    }
    .detail-row:last-of-type { border-bottom: none; }
    .detail-label { color: #6b7f95; font-size: .78rem; font-weight: 700;
                    text-transform: uppercase; letter-spacing: .04em; }
    .detail-value { font-weight: 600; color: #1e2d3d; }

    .sbadge { display: inline-block; padding: .2rem .65rem; border-radius: 20px;
              font-size: .72rem; font-weight: 700; text-transform: uppercase; }
    .sbadge-pendiente { background: #fff3e0; color: #e65100; }

    .f-label {
        display: block; font-size: .78rem; font-weight: 700;
        letter-spacing: .05em; text-transform: uppercase;
        color: #6b7f95; margin-bottom: .3rem;
    }
    .f-textarea {
        width: 100%; border: 1px solid #c8d4e0; border-radius: 4px;
        padding: .6rem .9rem; font-size: .95rem; resize: vertical; min-height: 80px;
        outline: none; transition: border-color .18s;
    }
    .f-textarea:focus { border-color: #1a4080; box-shadow: 0 0 0 3px rgba(26,64,128,.1); }

    .btn-approve {
        background: #2e7d32; color: #fff; border: none;
        padding: .65rem 1.6rem; border-radius: 4px; font-size: .97rem; font-weight: 700;
        cursor: pointer; display: inline-flex; align-items: center; gap: .4rem;
        transition: background .18s;
    }
    .btn-approve:hover { background: #1b5e20; }

    .btn-reject {
        background: transparent; color: #c62828; border: 1.5px solid #c62828;
        padding: .62rem 1.4rem; border-radius: 4px; font-size: .95rem; font-weight: 700;
        cursor: pointer; display: inline-flex; align-items: center; gap: .4rem;
        transition: all .18s;
    }
    .btn-reject:hover { background: #fce4ec; }

    .btn-back {
        background: transparent; color: #6b7f95; border: 1.5px solid #c8d4e0;
        padding: .62rem 1.2rem; border-radius: 4px; font-size: .9rem; font-weight: 600;
        text-decoration: none; display: inline-flex; align-items: center; gap: .4rem;
        transition: all .18s;
    }
    .btn-back:hover { background: #f0f4f8; color: #1e2d3d; }
</style>

<div class="page-header">
    <div class="container">
        <nav style="margin-bottom:.4rem;">
            <a asp-action="Index" asp-controller="Request"
               style="color:#a8bcd0;font-size:.82rem;text-decoration:none;">
                <i class="bi bi-send-check"></i> Solicitudes
            </a>
            <span style="color:#4a6080;margin:0 .4rem;">/</span>
            <span style="color:#fff;font-size:.82rem;">Revisar</span>
        </nav>
        <h1><i class="bi bi-clipboard-check me-2"></i>Revisar Solicitud</h1>
        <p>Aprueba o rechaza la solicitud del estudiante</p>
    </div>
</div>

<div class="container mb-5">
    <div class="review-card">

        <!-- Detalles de la solicitud -->
        <h5 style="color:#0a2240;font-weight:700;margin-bottom:1rem;
                   border-bottom:2px solid #c8a84b;padding-bottom:.5rem;">
            Detalle de la Solicitud
        </h5>

        <div class="detail-row">
            <span class="detail-label">ID Solicitud</span>
            <span class="detail-value" style="font-family:monospace;font-size:.8rem;">
                @Model.IdSolicitud
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Estudiante</span>
            <span class="detail-value">@(Model.User?.usuario ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Correo</span>
            <span class="detail-value">@(Model.User?.CorreoElectrónico ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Fecha Solicitud</span>
            <span class="detail-value">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Estado</span>
            <span class="sbadge sbadge-pendiente">@Model.EstadoSolicitud</span>
        </div>

        <!-- Formulario de revisión -->
        <h5 style="color:#0a2240;font-weight:700;margin:1.5rem 0 .8rem;
                   border-bottom:2px solid #c8a84b;padding-bottom:.5rem;">
            Decisión
        </h5>

        <form asp-action="Review" asp-controller="Request" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdSolicitud" value="@Model.IdSolicitud" />

            <div style="margin-bottom:1rem;">
                <label class="f-label" for="Observacion">Observación (opcional)</label>
                <textarea class="f-textarea" id="Observacion" name="Observacion"
                          placeholder="Motivo de aprobación o rechazo…"></textarea>
            </div>

            <div style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:.5rem;align-items:center;">

                <button type="submit" name="NuevoEstado" value="Aprobada" class="btn-approve">
                    <i class="bi bi-check-circle"></i> Aprobar
                </button>

                <button type="submit" name="NuevoEstado" value="Rechazada" class="btn-reject"
                        onclick="return confirm('¿Rechazar esta solicitud?')">
                    <i class="bi bi-x-circle"></i> Rechazar
                </button>

                <a asp-action="Index" asp-controller="Request" class="btn-back">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </form>

    </div>
</div>
